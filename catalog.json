        }
      ],
      "notes": "The original oh-my-opencode has become a standalone binary (omo); this slim fork is the one that still runs inside OpenCode."
    },
    {
      "id": "ai-second-brain",
      "name": "AI Second Brain (brain MCP)",
      "kind": "mcp",
      "group": "coding",
      "default": true,
      "repo": "https://github.com/JozsefKiss90/ai-second-brain",
      "summary": "Your personal notes → SQLite FTS5 → read-only MCP (brain_search, brain_read, brain_profile)",
      "requires": [
        "python"
      ],
      "git": {
        "repo": "https://github.com/JozsefKiss90/ai-second-brain.git"
      },
      "steps": [
        {
          "os": "win32",
          "run": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\setup.ps1",
          "cwd": "vendor/ai-second-brain"
        },
        {
          "os": "linux",
          "run": "python3 -m venv .venv && .venv/bin/pip install -e . mcp && .venv/bin/brain init",
          "cwd": "vendor/ai-second-brain"
        },
        {
          "os": "darwin",
          "run": "python3 -m venv .venv && .venv/bin/pip install -e . mcp && .venv/bin/brain init",
          "cwd": "vendor/ai-second-brain"
        }
      ],
      "config": {
        "mcp": {
          "brain": {
            "type": "local",
            "command": [
              "{{TOOLKIT}}/scripts/brain-mcp.{{SH}}"
            ],
            "enabled": true,
            "timeout": 15000
          }
        }
      },
      "notes": "setup.ps1 writes an opencode.json into vendor/ai-second-brain; the toolkit registers the same server globally via scripts/brain-mcp.cmd (Windows) / brain-mcp.sh. Import notes with `brain sync`."
    },
