  "tools": [
    {
      "id": "graphify",
      "name": "Graphify",
      "kind": "cli+skill",
      "group": "coding",
      "default": true,
      "repo": "https://github.com/safishamsi/graphify",
      "summary": "Turns a codebase/docs into a queryable knowledge graph; /graphify . in OpenCode",
      "requires": [
        "uv"
      ],
      "steps": [
        {
          "run": "uv tool install --upgrade graphifyy"
        },
        {
          "run": "graphify install --platform opencode"
        }
      ],
      "env": [
        {
          "name": "GEMINI_API_KEY",
          "required": false,
          "url": "https://aistudio.google.com/apikey",
          "note": "only for semantic extraction of PDFs/docs; code graphs are offline"
        }
      ],
      "notes": "Run `/graphify .` in a project; output in graphify-out/. Set GRAPHIFY_BACKEND=none to force offline."
    },
    {
      "id": "serena",
      "name": "Serena",
      "kind": "mcp",
      "group": "coding",
      "default": true,
      "repo": "https://github.com/oraios/serena",
      "summary": "LSP-based semantic code tools (find_symbol, references, symbol edits) for 40+ languages",
      "requires": [
        "uv"
      ],
      "config": {
        "mcp": {
          "serena": {
            "type": "local",
            "command": [
              "uvx",
              "--from",
              "git+https://github.com/oraios/serena",
              "serena",
              "start-mcp-server",
              "--context",
              "ide-assistant",
              "--project-from-cwd"
            ],
            "enabled": true,
            "timeout": 120000
          }
        }
      },
      "notes": "First start downloads Serena + language servers (slow once). Dashboard opens at http://localhost:24282 — disable in ~/.serena/serena_config.yml if annoying."
    },
    {
      "id": "context7",
      "name": "Context7",
      "kind": "mcp",
      "group": "coding",
      "default": true,
      "repo": "https://github.com/upstash/context7",
      "summary": "Up-to-date library documentation injected into the agent's context",
      "env": [
        {
          "name": "CONTEXT7_API_KEY",
          "required": false,
          "url": "https://context7.com/dashboard",
          "note": "free; raises rate limits"
        }
      ],
      "config": {
        "mcp": {
          "context7": {
            "type": "local",
            "command": [
              "npx",
              "-y",
              "@upstash/context7-mcp"
            ],
            "environment": {
              "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
            },
            "enabled": true,
            "timeout": 60000
          }
        }
      }
    },
    {
      "id": "ponytail",
      "name": "Ponytail",
      "kind": "plugin",
      "group": "coding",
      "default": true,
      "repo": "https://github.com/DietrichGebert/ponytail",
      "summary": "Makes the agent write less code (\"laziest senior dev\"); /ponytail-review, /ponytail-audit, /ponytail-debt",
      "config": {
        "plugin": [
          "@dietrichgebert/ponytail"
        ]
      }
    },
    {
      "id": "code-review",
      "name": "Code review (opencode-code-review)",
      "kind": "plugin",
      "group": "coding",
      "default": true,
      "repo": "https://github.com/MetalbolicX/opencode-code-review",
      "summary": "Reviews staged changes inside OpenCode: /ocr-review, agent ocr-review (Anthropic's code-review plugin is Claude-Code-only)",
      "config": {
        "plugin": [
          "opencode-code-review"
        ]
      },
      "agents": [
        "agents/reviewer.md"
      ],
      "commands": [
        "commands/review.md"
      ],
      "notes": "Also ships the toolkit's own @reviewer agent and /review command (works without the plugin)."
    },
    {
      "id": "claude-mem",
      "name": "claude-mem",
      "kind": "plugin",
      "group": "coding",
      "default": true,
      "repo": "https://github.com/thedotmack/claude-mem",
      "summary": "Persistent cross-session memory; supports OpenCode natively",
      "steps": [
        {
          "run": "npx -y claude-mem install --ide opencode",
          "optional": true
        }
      ],
      "env": [
        {
          "name": "CLAUDE_MEM_ONLINE_OPTIN",
          "required": false,
          "note": "set to false to skip the hosted-observer sign-in and use your own model keys"
        }
      ],
      "notes": "Interactive installer (email magic-link or your own OpenRouter/Gemini key). Restart OpenCode afterwards."
    },
    {
      "id": "codeburn",
      "name": "CodeBurn",
      "kind": "mcp+cli",
      "group": "coding",
      "default": true,
      "repo": "https://github.com/getagentseal/codeburn",
      "summary": "Token/cost tracking per project/model from the session logs OpenCode already writes",
      "steps": [
        {
          "run": "npm install -g codeburn"
        }
      ],
      "config": {
        "mcp": {
          "codeburn": {
            "type": "local",
            "command": [
              "npx",
              "-y",
              "codeburn",
              "mcp"
            ],
            "enabled": true,
            "timeout": 30000
          }
        }
      },
      "notes": "Run `codeburn` in a terminal for the TUI, `codeburn menubar` for a tray app."
    },
    {
      "id": "superpowers",
      "name": "Superpowers",
      "kind": "plugin",
      "group": "coding",
      "default": true,
      "repo": "https://github.com/obra/superpowers",
      "summary": "Methodology skills: brainstorming, TDD, systematic debugging, writing plans, subagent-driven development",
      "config": {
        "plugin": [
          "superpowers@git+https://github.com/obra/superpowers.git"
        ]
      }
    },
    {
      "id": "dcp",
      "name": "Dynamic Context Pruning",
      "kind": "plugin",
      "group": "coding",
      "default": true,
      "repo": "https://github.com/Tarquinen/opencode-dynamic-context-pruning",
      "summary": "Auto-prunes stale tool outputs from context; cheapest token saver for long sessions",
      "config": {
