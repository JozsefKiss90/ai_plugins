# Copy to .env and fill in what you have. Everything is optional unless marked (required for that tool).
# The installer exports these to your user environment (Windows: setx; macOS/Linux: ~/.config/opencode/env.sh).
# opencode.json references them as {env:NAME}, so nothing secret is written into the config file.

# --- coding ---
CONTEXT7_API_KEY=            # free, https://context7.com/dashboard (raises rate limits)
GITHUB_PERSONAL_ACCESS_TOKEN=   # required for the GitHub MCP, https://github.com/settings/tokens (repo, read:org)
GEMINI_API_KEY=              # optional: graphify semantic extraction of PDFs/docs
EXA_API_KEY=                 # optional, https://dashboard.exa.ai

# --- design ---
TWENTY_FIRST_API_KEY=        # required for 21st MCP, https://21st.dev/mcp
IMPECCABLE_NO_TELEMETRY=1

# --- web / scraping ---
FIRECRAWL_API_KEY=           # Firecrawl CLI/skills/MCP, https://www.firecrawl.dev/app/api-keys (free credits on signup)
SGAI_API_KEY=                # required for ScrapeGraph (paid), https://dashboard.scrapegraphai.com
APIFY_TOKEN=                 # required for Apify, https://console.apify.com/account/integrations

# --- security ---
STRIX_LLM=                   # e.g. anthropic/claude-sonnet-4-5 or openai/gpt-5
LLM_API_KEY=                 # key for STRIX_LLM
GHIDRA_INSTALL_DIR=          # only for REA native binary analysis

# --- marketing / outreach ---
RESEND_API_KEY=              # https://resend.com/api-keys (verify a sending domain first)
HUNTER_API_KEY=              # https://hunter.io/api-keys

# --- memory ---
CLAUDE_MEM_ONLINE_OPTIN=     # set to false to skip hosted sign-in and use your own model key

# --- infra ---
OMNIROUTE_API_KEY=sk_omniroute
